# gpui_apple's build script generates the C header its Metal shaders share with
# Rust by running cbindgen over gpui's sources. rules_rs does not surface a git
# crate's build-dependencies, so //tools/scene_header generates the header and the
# build script takes its path from GPUI_SCENE_HEADER. The runtime_shaders feature
# stitches that header into the shader source for the app to compile at run time;
# the other path shells out to `xcrun metal`, which only macOS has.
crate.annotation(
    additive_build_file_content = """filegroup(
    name = "licence",
    srcs = ["LICENSE-APACHE"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "scene_src",
    srcs = ["src/scene.rs"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "shader_type_srcs",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//visibility:public"],
)""",
    crate = "gpui",
    extra_aliased_targets = {
        "gpui_licence": "licence",
        "gpui_scene_src": "scene_src",
        "gpui_shader_type_srcs": "shader_type_srcs",
    },
    git_archive_sha256 = "8d2814d861ba4a2de232721c60d49cb4175b79b95ffa7155fdd556bcf2308405",
    git_archive_strip_prefix = "zed-{commit}",
    git_archive_url = "https://github.com/zed-industries/zed/archive/{commit}.tar.gz",
    patch_args = ["-p1"],
    patches = [
        "//patches/gpui:gpui-platform-drag.patch",
        "//patches/gpui:gpui-tooltip-offset.patch",
        "//patches/gpui:gpui-tooltip-skip-delay.patch",
        "//patches/gpui:gpui-tooltip-dismiss-on-press.patch",
        "//patches/gpui:gpui-tooltip-dismiss-on-escape.patch",
        "//patches/gpui:gpui-tooltip-optional.patch",
    ],
)
crate.annotation(
    additive_build_file_content = """filegroup(
    name = "metal_renderer_src",
    srcs = ["src/metal_renderer.rs"],
    visibility = ["//visibility:public"],
)""",
    build_script_data = ["//tools/scene_header:scene_h"],
    # buildifier: disable=canonical-repository
    # Location expressions resolve in the crate repository, which has no apparent
    # name for bviz's own.
    build_script_env = {"GPUI_SCENE_HEADER": "$(execpath @@//tools/scene_header:scene_h)"},
    crate = "gpui_apple",
    extra_aliased_targets = {"gpui_apple_metal_renderer_src": "metal_renderer_src"},
    patch_args = ["-p1"],
    patches = ["//patches/gpui_apple:gpui_apple-prebuilt-scene-header.patch"],
)
crate.annotation_select(
    crate = "gpui_apple",
    crate_features = ["runtime_shaders"],
    triples = DARWIN_TRIPLES,
)

