    gen_build_script = "off",  # otherwise it compiles the zstd it bundles
    deps = ["//third_party:zstd"],
)

# rav1e records its build environment through the built crate, whose RUSTC entry
# is the absolute path of the compiler and so bakes the exec root into the
# crate. built takes a BUILT_OVERRIDE_<package>_<field> for each entry it
# records, and demands RUSTC_VERSION alongside any RUSTC override; the values
# only surface in rav1e's own version banner, which this build never runs.
crate.annotation(
    build_script_env = {
        "BUILT_OVERRIDE_rav1e_RUSTC": "rustc",
        "BUILT_OVERRIDE_rav1e_RUSTC_VERSION": "unknown",
    },
    crate = "rav1e",
)

# freetype-sys compiles in C++ mode, so the cc crate would link GNU libstdc++.
# The hermetic toolchain ships libc++ instead, so emit no explicit C++ stdlib and
# let freetype's symbols resolve against the toolchain's libc++.
crate.annotation(
    build_script_env = {"CXXSTDLIB": ""},
    crate = "freetype-sys",
)

# objc-sys locates its ObjFW compatibility headers through a build-time
# env!("CARGO_MANIFEST_DIR"), which bakes the exec root into the compiled build
# script. Only the ObjFW runtime reads those headers and this build targets
# Apple's, so a relative manifest dir leaves the output independent of where the
# build ran.
crate.annotation(
    crate = "objc-sys",
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
)
