rs_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rs_toolchains.toolchain(
    edition = "2024",
    # The web build's panic strategy and target features must reach std.
    source_stdlib_triples = ["wasm32-unknown-unknown"],
    version = "1.95.0",
)
use_repo(rs_toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")

# Link Rust binaries with llvm/lld rather than the autodetected system cc. Each
# supported development host executes the toolchain and targets itself, which
# also covers every platform the release archives target. The browser is a
# target of its own.
llvm_toolchain = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
llvm_toolchain.exec(
    arch = "aarch64",
    os = "linux",
)
llvm_toolchain.exec(
    arch = "x86_64",
    os = "linux",
)
llvm_toolchain.exec(
    arch = "aarch64",
    os = "macos",
)
llvm_toolchain.exec(
    arch = "x86_64",
    os = "macos",
)
llvm_toolchain.target(
    arch = "aarch64",
    os = "linux",
)
llvm_toolchain.target(
    arch = "x86_64",
    os = "linux",
)
llvm_toolchain.target(
    arch = "aarch64",
    os = "macos",
)
llvm_toolchain.target(
    arch = "x86_64",
    os = "macos",
)
llvm_toolchain.target(
    arch = "wasm32",
    os = "none",
)
use_repo(llvm_toolchain, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")

# The macOS sysroot the llvm module fetches carries a small default set of
# frameworks, which this tag replaces wholesale; the defaults are therefore
# repeated alongside the ones gpui's macOS backend binds.
# ColorSync, FontServices and ImageIO come from the sysroot itself:
# ApplicationServices symlinks into them, and Bazel refuses to act on a dangling
# symlink. CFNetwork, CoreImage and CoreServices are re-exported by stub
# libraries lld has to resolve; OpenGL is what the cgl crate binds.
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.frameworks(names = [
    "AppKit",
    "ApplicationServices",
    "Carbon",
    "CFNetwork",
    "ColorSync",
    "CoreFoundation",
    "CoreGraphics",
    "CoreImage",
    "CoreServices",
    "CoreText",
    "CoreVideo",
    "FontServices",
    "Foundation",
    "ImageIO",
    "Kernel",
    "Metal",
    "MetalPerformanceShaders",
    "OSLog",
    "OpenGL",
    "QuartzCore",
    "Security",
    "SystemConfiguration",
    "UserNotifications",
])

DARWIN_TRIPLES = [
    "aarch64-apple-darwin",
    "x86_64-apple-darwin",
]

LINUX_TRIPLES = [
    "aarch64-unknown-linux-gnu",
    "x86_64-unknown-linux-gnu",
]

WEB_TRIPLES = ["wasm32-unknown-unknown"]

PLATFORM_TRIPLES = DARWIN_TRIPLES + LINUX_TRIPLES + WEB_TRIPLES

