load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//licenses/rules:license_kind.bzl", "license_kind")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")

# rules_rs's generated crate repositories can't resolve the root module's bazel_dep
# apparent names, and canonical repo names must not be hardcoded. Alias the BCR
# system libraries here so MODULE.bazel crate annotations can reference them as
# main-repo labels (@@//third_party:...).

alias(
    name = "xkbcommon",
    actual = "@xkbcommon//:xkbcommon",
    visibility = ["//visibility:public"],
)

alias(
    name = "wayland_client",
    actual = "@wayland//:wayland_client",
    visibility = ["//visibility:public"],
)

alias(
    name = "wayland_cursor",
    actual = "@wayland//:wayland_cursor",
    visibility = ["//visibility:public"],
)

alias(
    name = "zstd",
    actual = "@zstd//:zstd",
    visibility = ["//visibility:public"],
)

package_metadata(
    name = "xkbcommon_package_metadata",
    attributes = [":xkbcommon_license"],
    purl = "pkg:bazel/xkbcommon",
    visibility = ["//bviz:__pkg__"],
)

license(
    name = "xkbcommon_license",
    kind = ":xkbcommon_license_kind",
    text = "@xkbcommon//:LICENSE",
)

# The LICENSE file collects the notices of several source files, each under its
# own terms.
license_kind(
    name = "xkbcommon_license_kind",
    full_name = "libxkbcommon licences",
    identifier = "MIT AND MIT-open-group AND HPND AND HPND-sell-variant AND DEC-3-Clause",
)

package_metadata(
    name = "wayland_package_metadata",
    attributes = [":wayland_license"],
    purl = "pkg:bazel/wayland",
    visibility = ["//bviz:__pkg__"],
)

license(
    name = "wayland_license",
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "@wayland//:COPYING",
)

package_metadata(
    name = "zstd_package_metadata",
    attributes = [":zstd_license"],
    purl = "pkg:bazel/zstd",
    visibility = ["//bviz:__pkg__"],
)

license(
    name = "zstd_license",
    kind = ":zstd_license_kind",
    text = "@zstd//:LICENSE",
)

license_kind(
    name = "zstd_license_kind",
    full_name = "BSD 3-Clause License or GNU General Public License v2.0 only",
    identifier = "BSD-3-Clause OR GPL-2.0-only",
)

package_metadata(
    name = "libffi_package_metadata",
    attributes = [":libffi_license"],
    purl = "pkg:bazel/libffi",
    visibility = ["//bviz:__pkg__"],
)

license(
    name = "libffi_license",
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "@libffi//:LICENSE",
)

package_metadata(
    name = "protobuf_package_metadata",
    attributes = [":protobuf_license"],
    purl = "pkg:bazel/protobuf",
    visibility = ["//bviz:__pkg__"],
)

license(
    name = "protobuf_license",
    kind = "@package_metadata//licenses/spdx:BSD-3-Clause",
    text = "@com_google_protobuf//:LICENSE",
)

package_metadata(
    name = "zed_package_metadata",
    attributes = [":zed_license"],
    purl = "pkg:github/zed-industries/zed@v1.24.3",
    visibility = ["//bviz:__pkg__"],
)

license(
    name = "zed_license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "@crates//:gpui_licence",
)

package_metadata(
    name = "rules_rust_package_metadata",
    attributes = [":rules_rust_license"],
    purl = "pkg:bazel/rules_rust",
    visibility = ["//bviz:__pkg__"],
)

license(
    name = "rules_rust_license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "@rules_rs_rules_rust//:LICENSE.txt",
)

# The Rust standard library, which the Rust toolchain links into every binary.
package_metadata(
    name = "rust_std_package_metadata",
    attributes = [":rust_std_license"],
    purl = "pkg:github/rust-lang/rust",
    visibility = ["//bviz:__pkg__"],
)

license(
    name = "rust_std_license",
    kind = ":rust_std_license_kind",
)

license_kind(
    name = "rust_std_license_kind",
    full_name = "MIT License or Apache License 2.0",
    identifier = "MIT OR Apache-2.0",
)
