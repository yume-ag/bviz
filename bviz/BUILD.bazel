load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//platforms:web.bzl", "web_executable")
load("//tools/notices:notices.bzl", "third_party_notices")

rust_binary(
    name = "bviz",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz",
    visibility = [
        "//:__pkg__",
        "//dist:__pkg__",
    ],
    deps = [
        "//alloc",
        "//bazel_flags/args",
        "//cli",
        "//invocation",
        "//sniff",
        "//ui/components",
        "//ui/console:console_lib",
        "//ui/execlog:execlog_lib",
        "//ui/graph:graph_lib",
        "//ui/graph/args",
        "//ui/session",
        "//ui/trace:trace_lib",
        "//ui/workspace",
        "//util/input",
        "@crates//:clap",
        "@crates//:gpui",
    ] + select({
        "@platforms//cpu:wasm32": [
            "//ui/web",
            "//util/switches",
        ],
        "//conditions:default": [],
    }),
)

rust_test(
    name = "bviz_test",
    size = "small",
    compile_data = ["//terminal:testdata/sample.bep"],
    crate = ":bviz",
    rustc_env = {"SAMPLE_BEP": "$(execpath //terminal:testdata/sample.bep)"},
)

third_party_notices(
    name = "third_party_notices",
    binary = ":bviz",
    denied_licences = [
        "AGPL-",
        "GPL-",
        "LGPL-",
    ],
    own_package_metadata = "//:package_metadata",
    preferred_licences = ["Apache-2.0"],
    repository_package_metadata = [
        "//third_party:libffi_package_metadata",
        "//third_party:protobuf_package_metadata",
        "//third_party:rules_rust_package_metadata",
        "//third_party:wayland_package_metadata",
        "//third_party:xkbcommon_package_metadata",
        "//third_party:zed_package_metadata",
        "//third_party:zstd_package_metadata",
    ],
    toolchain_package_metadata = ["//third_party:rust_std_package_metadata"],
    visibility = ["//dist:__pkg__"],
)

platform_transition_filegroup(
    name = "third_party_notices_web",
    srcs = [":third_party_notices"],
    target_platform = "//platforms:wasm32_web",
)

platform_transition_filegroup(
    name = "third_party_notices_web_threads",
    srcs = [":third_party_notices"],
    target_platform = "//platforms:wasm32_web_threads",
    visibility = ["//web:__pkg__"],
)

# Both notices have the same runfiles path; a copy gives each one of its own.
[
    copy_file(
        name = name + "_copy",
        src = ":" + name,
        out = name + ".txt",
    )
    for name in [
        "third_party_notices_web",
        "third_party_notices_web_threads",
    ]
]

rust_test(
    name = "web_notices_test",
    size = "small",
    srcs = ["web_notices_test.rs"],
    crate_name = "bviz_web_notices_test",
    data = [
        ":third_party_notices_web.txt",
        ":third_party_notices_web_threads.txt",
    ],
    env = {
        "WEB_NOTICES": "$(rlocationpath :third_party_notices_web.txt)",
        "WEB_THREADS_NOTICES": "$(rlocationpath :third_party_notices_web_threads.txt)",
    },
    deps = ["@rules_rs_rules_rust//rust/runfiles"],
)

[
    web_executable(
        name = "bviz_" + platform,
        executable = ":bviz",
        platform = "//platforms:" + platform,
        visibility = ["//web:__pkg__"],
    )
    for platform in [
        "wasm32_web",
        "wasm32_web_threads",
    ]
]
