load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//tools/wasm_test:wasm_test.bzl", "wasm_test")

# The query-language test cases taken from Bazel's own tests.
filegroup(
    name = "bazel_goldens_src",
    srcs = ["src/query_lang/bazel_goldens.rs"],
    package_metadata = [
        "//:package_metadata",
        "//LICENSES:bazel",
    ],
)

rust_library(
    name = "layout",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/query_lang/bazel_goldens.rs"],
    ) + [":bazel_goldens_src"],
    crate_name = "bviz_graph_layout",
    visibility = [
        "//graph/layout/oracle:__pkg__",
        "//ui/graph:__pkg__",
    ],
    deps = [
        "//bazel_flags",
        "//label",
        "//util/input",
        "//util/parallel",
        "@bazel_query_proto//:bazel_query_rust_proto",
        "@crates//:fixedbitset",
        "@crates//:org-eclipse-elk-alg-layered",
        "@crates//:org-eclipse-elk-core",
        "@crates//:org-eclipse-elk-graph",
        "@crates//:prost",
        "@crates//:rayon",
        "@crates//:regex-automata",
        "@crates//:regex-syntax",
        "@crates//:rustc-hash",
    ],
)

rust_test(
    name = "layout_test",
    size = "small",
    crate = ":layout",
    deps = ["@crates//:fastrand"],
)

rust_binary(
    name = "bench_relayout",
    srcs = ["bench/relayout.rs"],
    crate_name = "bench_relayout",
    deps = [
        ":layout",
        "//util/time",
    ],
)

rust_binary(
    name = "bench_load",
    srcs = ["bench/load.rs"],
    crate_name = "bench_load",
    deps = [
        ":layout",
        "//alloc",
        "//util/input",
        "//util/time",
    ],
)

wasm_test(
    name = "layout_wasm_test",
    size = "medium",
    test = ":layout_test",
)
