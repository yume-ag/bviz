load("@rules_java//java:java_binary.bzl", "java_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//platforms:web.bzl", "NOT_WEB")

java_binary(
    name = "query_oracle",
    testonly = True,
    srcs = [
        "java/bviz/oracle/ProtoQueryEnvironment.java",
        "java/bviz/oracle/QueryOracle.java",
    ],
    main_class = "bviz.oracle.QueryOracle",
    target_compatible_with = NOT_WEB,
    deps = ["@bazel_server_jar//:server"],
)

rust_test(
    name = "query_oracle_test",
    size = "small",
    srcs = [
        "evaluation.rs",
        "query_oracle_test.rs",
    ],
    crate_name = "bviz_query_oracle_test",
    data = [":query_oracle"],
    env = {"QUERY_ORACLE": "$(rlocationpath :query_oracle)"},
    deps = [
        "//graph/layout",
        "//util/parallel",
        "@bazel_query_proto//:bazel_query_rust_proto",
        "@crates//:fastrand",
        "@crates//:prost",
        "@rules_rs_rules_rust//rust/runfiles",
    ],
)
