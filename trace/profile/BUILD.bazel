load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//tools/wasm_test:wasm_test.bzl", "wasm_test")

rust_library(
    name = "profile",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_trace_profile",
    visibility = [
        "//critical_path:__pkg__",
        "//trace/layout:__pkg__",
        "//ui/trace:__pkg__",
    ],
    deps = [
        "//invocation",
        "//util/input",
        "//util/parallel",
        "//util/switches",
        "//util/time",
        "@crates//:crossbeam-channel",
        "@crates//:crossbeam-utils",
        "@crates//:flate2",
        "@crates//:hashbrown",
        "@crates//:rustc-hash",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "profile_test",
    size = "small",
    crate = ":profile",
    deps = ["@crates//:fastrand"],
)

rust_binary(
    name = "bench_inflate",
    srcs = ["bench/inflate.rs"],
    crate_name = "bench_inflate",
    deps = [
        ":profile",
        "//alloc",
        "//util/time",
        "@crates//:flate2",
    ],
)

rust_binary(
    name = "bench_load",
    srcs = ["bench/load.rs"],
    crate_name = "bench_load",
    deps = [
        ":profile",
        "//alloc",
        "//util/time",
    ],
)

wasm_test(
    name = "profile_wasm_test",
    test = ":profile_test",
)
