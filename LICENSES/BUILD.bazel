load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")

# The terms of work bviz carries in its own tree rather than fetching: source
# written from an upstream example, a constant taken verbatim, a patch that
# ships the lines it replaces. A text held here is the one the work came with;
# where Bazel fetches that same text with other work from the same source, the
# declaration points at the fetched copy instead. Work Bazel fetches declares
# its own terms from the archive it arrives in.

package_metadata(
    name = "gpui_derived_source",
    attributes = [":gpui_license"],
    purl = "pkg:github/zed-industries/zed@v1.6.3",
    visibility = [
        "//tools/scene_header:__pkg__",
        "//ui/components:__pkg__",
        "//ui/shell:__pkg__",
    ],
)

package_metadata(
    name = "gpui_patches",
    attributes = [":gpui_license"],
    purl = "pkg:github/zed-industries/zed@v1.24.3",
    visibility = [
        "//patches/gpui:__pkg__",
        "//patches/gpui_apple:__pkg__",
        "//patches/gpui_linux:__pkg__",
        "//patches/gpui_web:__pkg__",
        "//patches/gpui_wgpu:__pkg__",
    ],
)

license(
    name = "gpui_license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "gpui.txt",
)

package_metadata(
    name = "alacritty",
    attributes = [":alacritty_license"],
