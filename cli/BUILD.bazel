load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//tools/wasm_test:wasm_test.bzl", "wasm_test")

rust_library(
    name = "cli",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_cli",
    version = "0.1.0-rc1",
    visibility = ["//bviz:__pkg__"],
    deps = [
        "//bazel_flags/args",
        "//ui/console/args",
        "//ui/execlog/args",
        "//ui/graph/args",
        "//ui/trace/args",
        "@crates//:clap",
    ],
)

rust_test(
    name = "cli_test",
    size = "small",
    crate = ":cli",
)

wasm_test(
    name = "cli_wasm_test",
    test = ":cli_test",
)
