load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//tools/wasm_test:wasm_test.bzl", "wasm_test")

rust_library(
    name = "invocation",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_invocation",
    visibility = [
        "//bviz:__pkg__",
        "//critical_path:__pkg__",
        "//execlog:__pkg__",
        "//terminal:__pkg__",
        "//trace/profile:__pkg__",
        "//ui/components:__pkg__",
        "//ui/console:__pkg__",
        "//ui/execlog:__pkg__",
        "//ui/graph:__pkg__",
        "//ui/playback:__pkg__",
        "//ui/session:__pkg__",
        "//ui/spawn_phase:__pkg__",
        "//ui/trace:__pkg__",
        "//ui/workspace:__pkg__",
    ],
)

rust_test(
    name = "invocation_test",
    size = "small",
    crate = ":invocation",
)

wasm_test(
    name = "invocation_wasm_test",
    test = ":invocation_test",
)
