platform(
    name = "local_gnu",
    constraint_values = [
        "@llvm//constraints/libc:gnu.2.28",
    ],
    parents = ["@platforms//host"],
)

# BuildBuddy execution platform: the executor's own constraints plus its
# container image. The libc constraint must match what the registered toolchains
# build against (gnu.2.28) so they resolve here, and the image's glibc must
# cover that floor so the tools load on the executor; rbe-ubuntu24-04 ships 2.39.
# Wired in via --extra_execution_platforms in .bazelrc.remote.
platform(
    name = "rbe",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@llvm//constraints/libc:gnu.2.28",
    ],
    exec_properties = {
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:f7db0d4791247f032fdb4451b7c3ba90e567923a341cc6dc43abfc283436791a",
    },
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.28",
    ],
    visibility = ["//dist:__pkg__"],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.28",
    ],
    visibility = ["//dist:__pkg__"],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    visibility = ["//dist:__pkg__"],
)

platform(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
    visibility = ["//dist:__pkg__"],
)

# The web build's main thread stack. Where no thread can start, the main thread
# runs the graph layout engine, whose recursion on a large graph runs deeper
# than the stack rustc gives WebAssembly.
WEB_MAIN_THREAD_STACK = 8 << 20

# The browser's WebAssembly target. Both web platforms assume a browser with the
# 2023 baseline features: fixed-width SIMD and exception handling, the latter
# for unwinding panics.
platform(
    name = "wasm32_web",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:none",
    ],
    flags = [
        "--copt=-msimd128",
        "--@rules_rs_rules_rust//rust/settings:extra_rustc_flag=-Ctarget-feature=+simd128,+exception-handling",
        "--@rules_rs_rules_rust//rust/settings:extra_rustc_flag=-Cpanic=unwind",
        "--@rules_rs_rules_rust//rust/settings:extra_rustc_flag=-Clink-arg=-zstack-size=%d" % WEB_MAIN_THREAD_STACK,
    ],
)

WASM32_ADDRESS_SPACE = 1 << 32

# The web build with threads, for a page served cross-origin isolated. Its
# memory, which may grow to the whole 32-bit address space, is shared between
# the workers and imported, so that wasm-bindgen can hand it to each one; the
# exports are the symbols wasm-bindgen's threads transform reads.
platform(
    name = "wasm32_web_threads",
    constraint_values = ["@rules_rs//rs/platforms/constraints:wasm_threads_on"],
    flags = [
        "--@rules_rs_rules_rust//rust/settings:extra_rustc_flag=-Ctarget-feature=+atomics,+bulk-memory,+mutable-globals",
        "--@rules_rs_rules_rust//rust/settings:extra_rustc_flag=-Clink-args=--shared-memory --max-memory=%d --import-memory --export=__heap_base --export=__wasm_init_tls --export=__tls_size --export=__tls_align --export=__tls_base" % WASM32_ADDRESS_SPACE,
        "--copt=-matomics",
        "--copt=-mbulk-memory",
    ],
    parents = [":wasm32_web"],
    visibility = ["//bviz:__pkg__"],
)

# The web build as wasmtime runs its tests. wasmtime runs only the exnref form
# of exception handling, so the tests encode unwinding in that form, where the
# shipped web build keeps the legacy one.
platform(
    name = "wasm32_web_test",
    flags = ["--@rules_rs_rules_rust//rust/settings:extra_rustc_flag=-Cllvm-args=-wasm-use-legacy-eh=false"],
    parents = [":wasm32_web"],
    visibility = ["//tools/wasm_test:__pkg__"],
)
