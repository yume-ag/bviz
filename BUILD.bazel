load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")

exports_files(
    [
        "LICENSE",
        "NOTICE",
    ],
    visibility = [
        "//dist:__pkg__",
        "//web:__pkg__",
    ],
)

exports_files(["clippy.toml"])

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = "pkg:github/yume-ag/bviz",
    visibility = ["//visibility:public"],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "LICENSE",
)

alias(
    name = "bviz",
    actual = "//bviz",
)

buildifier(
    name = "buildifier",
    exclude_patterns = ["./bazel-*/**"],
    lint_mode = "fix",
    mode = "fix",
)

buildifier_test(
    name = "buildifier_test",
    size = "small",
    lint_mode = "warn",
    mode = "diff",
    no_sandbox = True,
    # It checks the source tree, which a remote worker does not have, so a
    # remote run passes without checking anything.
    tags = ["no-remote-exec"],
    workspace = "//:MODULE.bazel",
)
