load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

exports_files(
    ["testdata/sample.bep"],
    visibility = [
        "//bviz:__pkg__",
        "//sniff:__pkg__",
    ],
)

# display/mod.rs holds alacritty's URL hint pattern verbatim.
filegroup(
    name = "display_src",
    srcs = ["src/display/mod.rs"],
    package_metadata = [
        "//:package_metadata",
        "//LICENSES:alacritty",
    ],
)

rust_library(
    name = "terminal",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/display/mod.rs"],
    ) + [":display_src"],
    crate_name = "bviz_terminal",
    visibility = ["//ui/console:__pkg__"],
    deps = [
        "//invocation",
        "//util/input",
        "@bazel_build_event_proto//:bazel_build_event_rust_proto",
        "@crates//:alacritty_terminal",
        "@crates//:prost",
    ],
)

rust_test(
    name = "terminal_test",
    size = "small",
    compile_data = ["testdata/sample.bep"],
    crate = ":terminal",
)

rust_binary(
    name = "bench_load",
    srcs = ["bench/load.rs"],
    crate_name = "bench_load",
    deps = [
        ":terminal",
        "//alloc",
        "//util/input",
        "//util/time",
    ],
)
