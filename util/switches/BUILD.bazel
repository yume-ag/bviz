load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "switches",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_switches",
    visibility = [
        "//bviz:__pkg__",
        "//trace/profile:__pkg__",
        "//ui/graph:__pkg__",
        "//ui/trace:__pkg__",
    ],
    deps = select({
        "@platforms//cpu:wasm32": [
            "@crates//:percent-encoding",
            "@crates//:web-sys",
        ],
        "//conditions:default": [],
    }),
)

rust_test(
    name = "switches_test",
    size = "small",
    crate = ":switches",
    deps = ["@crates//:percent-encoding"],
)
