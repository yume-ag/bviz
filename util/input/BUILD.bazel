load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "input",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_input",
    visibility = [
        "//bviz:__pkg__",
        "//trace/profile:__pkg__",
        "//ui/trace:__pkg__",
    ],
)

rust_test(
    name = "input_test",
    size = "small",
    crate = ":input",
)
