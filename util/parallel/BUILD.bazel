load("@rules_rs//rs:rust_library.bzl", "rust_library")

rust_library(
    name = "parallel",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_parallel",
    visibility = [
        "//alloc:__pkg__",
        "//execlog:__pkg__",
        "//graph/layout:__pkg__",
        "//graph/layout/oracle:__pkg__",
        "//trace/layout:__pkg__",
        "//trace/profile:__pkg__",
        "//ui/components:__pkg__",
        "//ui/graph:__pkg__",
        "//ui/web:__pkg__",
        "//util/input:__pkg__",
    ],
    deps = [
        "//util/switches",
        "@crates//:rayon",
    ] + select({
        "@platforms//cpu:wasm32": [
            "@crates//:js-sys",
            "@crates//:wasm_thread",
        ],
        "//conditions:default": ["@crates//:num_cpus"],
    }),
)
