load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//tools/wasm_test:wasm_test.bzl", "wasm_test")

rust_library(
    name = "critical_path",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_critical_path",
    visibility = ["//ui/trace:__pkg__"],
    deps = [
        "//invocation",
        "//trace/profile",
    ],
)

rust_test(
    name = "critical_path_test",
    size = "small",
    crate = ":critical_path",
)

wasm_test(
    name = "critical_path_wasm_test",
    test = ":critical_path_test",
)
