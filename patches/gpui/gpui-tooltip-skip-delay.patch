+/// Whether a tooltip is showing in `window`, or hid in any window within
+/// [`TOOLTIP_SKIP_DELAY`].
+fn skips_show_delay(window: &Window, cx: &App) -> bool {
+    window.tooltip_bounds.is_some()
+        || cx.tooltip_hidden_at.is_some_and(|hidden_at| {
+            cx.background_executor().now().duration_since(hidden_at) < TOOLTIP_SKIP_DELAY
+        })
+}
+
 fn show_tooltip(
