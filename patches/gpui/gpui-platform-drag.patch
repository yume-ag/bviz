+/// What a drag the window system carries has done to a window: one it carries
+/// over the window offering the mime type that window registered with
+/// [`crate::Window::accept_platform_drag`], or the end of the one that window
+/// handed over with [`crate::Window::start_platform_drag`].
+///
+/// The window system owns the pointer for as long as it carries a drag, so a
+/// window hears of one through these events rather than through mouse events.
+#[derive(Debug, Clone, Copy)]
+pub enum PlatformDragEvent {
+    /// A drag came over the window, at that position relative to it.
+    Entered(Point<Pixels>),
+    /// The drag over the window moved to that position relative to it.
+    Moved(Point<Pixels>),
+    /// The drag over the window left it without being dropped there.
+    Left,
+    /// A drag was dropped on the window, at that position relative to it.
+    Dropped(Point<Pixels>),
+    /// The drag this window handed over is over.
+    Ended(PlatformDragEnd),
+}
+
+impl PlatformDragEvent {
+    /// Where the drag is, relative to the window it is over. Nothing for the
+    /// reports that say what became of a drag rather than where it is.
+    pub fn position(&self) -> Option<Point<Pixels>> {
+        match self {
+            Self::Entered(at) | Self::Moved(at) | Self::Dropped(at) => Some(*at),
+            Self::Left | Self::Ended(_) => None,
+        }
+    }
+}
+
+/// How a drag a window handed to the window system ended.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PlatformDragEnd {
+    /// It was dropped where a destination took what it carried.
+    Taken,
+    /// It was dropped where nothing took what it carried.
+    Released,
+    /// It ended without being dropped at all: the user called it off, or the
+    /// window system did.
+    Cancelled,
+}
+
