+/// How many pixels of a drag icon's image go to one of the window's, so that an
+/// image rasterized for a scaled display is drawn at the size it was measured
+/// at.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct IconScale(i32);
+
+impl IconScale {
+    /// The scale an icon is drawn at on a display of `factor`: whole, since a
+    /// window system draws an image a whole number of its pixels to one of the
+    /// window's, and at least one, since an image drawn at none of them is no
+    /// image at all.
+    pub fn for_display(factor: f32) -> Self {
+        Self((factor.ceil()).max(1.) as i32)
+    }
+
+    /// How many of the image's pixels go to one of the window's.
+    pub fn get(self) -> i32 {
+        self.0
+    }
+
+    /// `extent` of the window's pixels in the image's, rounded out to a whole
+    /// window pixel and to at least one, which is what leaves the image a whole
+    /// multiple of the scale.
+    fn extent(self, extent: Pixels) -> DevicePixels {
+        DevicePixels(f32::from(extent).ceil().max(1.) as i32 * self.0)
+    }
+}
+
+/// The image a window system draws where the pointer carries a drag
+/// ([`PlatformWindow::start_platform_drag`]). Both its dimensions are whole
+/// multiples of the scale it is drawn at, which is what a window system takes:
+/// Wayland raises a protocol error on a buffer its scale does not divide.
+pub struct DragIcon {
+    size: Size<DevicePixels>,
+    scale: IconScale,
+    pixels: Vec<u8>,
+}
+
+impl DragIcon {
+    /// How many bytes of the image one of its pixels takes.
+    pub const BYTES_PER_PIXEL: usize = 4;
+
+    /// An icon `size` of the window's pixels across, drawn `scale` of the
+    /// image's pixels to one of those, with `draw` filling the image in: it is
+    /// handed the image and how many pixels across and down that is, four bytes
+    /// to the pixel row by row from its top left — blue, green, red, and an
+    /// alpha the other three are already multiplied by.
+    pub fn new(
+        size: Size<Pixels>,
+        scale: IconScale,
+        draw: impl FnOnce(&mut [u8], Size<DevicePixels>),
+    ) -> Self {
+        let size = Size {
+            width: scale.extent(size.width),
+            height: scale.extent(size.height),
+        };
+        let mut pixels =
+            vec![0; size.width.0 as usize * size.height.0 as usize * Self::BYTES_PER_PIXEL];
+        draw(&mut pixels, size);
+        Self {
+            size,
+            scale,
+            pixels,
+        }
+    }
+
+    /// How large the image is, in its own pixels.
+    pub fn size(&self) -> Size<DevicePixels> {
+        self.size
+    }
+
+    /// How many of the image's pixels go to one of the window's.
+    pub fn scale(&self) -> IconScale {
+        self.scale
+    }
+
+    /// The image, as [`DragIcon::new`] describes it.
+    pub fn pixels(&self) -> &[u8] {
+        &self.pixels
+    }
+}
+
