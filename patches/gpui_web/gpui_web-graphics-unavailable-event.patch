+/// Tells the page, through a `gpui:graphicsunavailable` event on its window
+/// whose `message` is `error`, so that a page with a way of its own to explain
+/// the failure can take over.
+fn dispatch_graphics_unavailable(browser_window: &web_sys::Window, error: &anyhow::Error) {
+    let Ok(event) = web_sys::Event::new("gpui:graphicsunavailable") else {
+        return;
+    };
+    js_sys::Reflect::set(&event, &"message".into(), &format!("{error:#}").into()).ok();
+    browser_window.dispatch_event(&event).ok();
+}
