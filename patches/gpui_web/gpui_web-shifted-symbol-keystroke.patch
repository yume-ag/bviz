+/// The modifiers a keystroke of `key` names: shift only on a key whose
+/// character has case, since the key a browser reports for a shifted symbol
+/// is already the symbol shift typed, as `?` for shift and `/`.
+fn keystroke_modifiers(key: &str, mut modifiers: Modifiers) -> Modifiers {
+    if modifiers.shift && key.chars().count() == 1 && key.to_lowercase() == key.to_uppercase() {
+        modifiers.shift = false;
+    }
+    modifiers
+}
