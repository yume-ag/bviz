+
+    /// Initializes the global thread pool as
+    /// [`build_global`](#method.build_global) does, without waiting for
+    /// its threads to start. The pool takes jobs at once and its threads
+    /// run them once started, which suits a thread that cannot block.
+    pub fn build_global_without_waiting(self) -> Result<(), ThreadPoolBuildError> {
+        registry::init_global_registry(self)?;
+        Ok(())
+    }
