Clear hover when the pointer leaves the window

License: Apache-2.0 (Zed v1.24.3)

diff --git a/crates/gpui_linux/src/linux/wayland/client.rs b/crates/gpui_linux/src/linux/wayland/client.rs
index bc73fc3..4b88758 100644
--- a/crates/gpui_linux/src/linux/wayland/client.rs
+++ b/crates/gpui_linux/src/linux/wayland/client.rs
@@ -2352,6 +2352,17 @@ impl Dispatch<wl_pointer::WlPointer, ()> for WaylandClientStatePtr {
             }
             wl_pointer::Event::Leave { .. } => {
                 if let Some(focused_window) = state.mouse_focused_window.clone() {
+                    // gpui recomputes hover only on mouse-move, so a bare Leave would
+                    // leave whatever was under the cursor still hovered. Move the
+                    // cursor off-screen first to clear hover and hit-test state.
+                    let moved_off = PlatformInput::MouseMove(MouseMoveEvent {
+                        position: point(px(-1.), px(-1.)),
+                        // Hover ignores buttons, and a Leave with one held is a
+                        // gesture the compositor took away: a drag ends here, and
+                        // this off-screen point is not somewhere it was dragged to.
+                        pressed_button: None,
+                        modifiers: state.modifiers,
+                    });
                     let input = PlatformInput::MouseExited(MouseExitEvent {
                         position: state.mouse_location.unwrap(),
                         pressed_button: state.button_pressed,
@@ -2363,6 +2374,7 @@ impl Dispatch<wl_pointer::WlPointer, ()> for WaylandClientStatePtr {
                     state.cursor_hidden_window = None;
 
                     drop(state);
+                    focused_window.handle_input(moved_off);
                     focused_window.handle_input(input);
                     focused_window.set_hovered(false);
                 }
