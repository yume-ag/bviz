+/// Whether `offer` carries the mime type the application takes a drag of.
+fn carries_accepted(state: &WaylandClientState, offer: &wl_data_offer::WlDataOffer) -> bool {
+    let Some(mime_type) = &state.accepted_drag_mime else {
