+    /// Hands the gesture the pointer is in to the compositor as a drag out of
+    /// `surface` of the window `origin`, offering `mime_type` and drawing
+    /// `icon` where the pointer carries it, and reports whether the compositor
+    /// took it. It takes none where it offers no data device, where a drag this
+    /// client handed over is still running, where no press of the pointer names
+    /// the gesture to start the drag from, and where the icon cannot be handed
+    /// over.
+    pub fn start_platform_drag(
+        &self,
+        origin: &WaylandWindowStatePtr,
+        surface: &wl_surface::WlSurface,
+        mime_type: &str,
+        icon: DragIcon,
+    ) -> bool {
+        let client = self.get_client();
+        let mut state = client.borrow_mut();
+        if state.outgoing_drag.is_some() || state.external_drag.is_some() {
+            return false;
+        }
+        let (Some(data_device_manager), Some(data_device)) = (
+            state.globals.data_device_manager.clone(),
+            state.data_device.clone(),
+        ) else {
+            return false;
+        };
+        // A drag is started from the press holding the pointer, and the
+        // compositor ignores a request naming no press at all.
+        let serial = state.serial_tracker.get(SerialKind::MousePress);
+        if serial.as_raw() == 0 {
+            return false;
+        }
+        let Some((icon_surface, buffer)) = drag_icon(&state.globals, &icon) else {
+            return false;
+        };
+        let source = data_device_manager.create_data_source(&state.globals.qh, DragSourceData);
+        source.offer(mime_type.to_string());
+        source.set_actions(DND_ACTIONS);
+        // The request is allowed only on a source that is still to be dragged,
+        // so it has to precede `start_drag`.
+        let toplevel_drag = state
+            .globals
+            .toplevel_drag_manager
+            .as_ref()
+            .map(|manager| manager.get_xdg_toplevel_drag(&source, &state.globals.qh, ()));
+        // The surface takes its role from this request, so what it shows is
+        // attached only once the compositor knows what it is for.
+        data_device.start_drag(Some(&source), surface, Some(&icon_surface), serial.as_raw());
+        icon_surface.attach(Some(&buffer), 0, 0);
+        let size = icon.size();
+        let scale = icon.scale().get();
+        icon_surface.damage(0, 0, size.width.0 / scale, size.height.0 / scale);
+        icon_surface.commit();
+        state.outgoing_drag = Some(OutgoingDrag {
+            source,
+            icon: icon_surface,
+            buffer,
+            origin: origin.clone(),
+            dropped: false,
+            toplevel_drag,
+        });
+        true
+    }
