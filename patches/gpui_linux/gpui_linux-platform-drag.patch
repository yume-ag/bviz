+/// A drag handed to the compositor, held from the `start_drag` request until
+/// the compositor reports the gesture over.
+///
+/// A `wl_data_source` reports a release over a surface that takes nothing
+/// exactly as it reports a gesture called off, so `dropped` is what parts the
+/// two; how far it parts them rests on `toplevel_drag`, since a compositor
+/// that honours the object reports such a release as a drop, and one that has
+/// none to give leaves `dropped` marking only a release something took.
+struct OutgoingDrag {
+    /// The source the compositor carries the drag on, which its events name.
+    source: wl_data_source::WlDataSource,
+    /// What the compositor draws where the pointer carries the drag, and the
+    /// pixels behind it, both let go of with the drag.
+    icon: wl_surface::WlSurface,
+    buffer: wl_buffer::WlBuffer,
+    /// The window the drag started from, which hears how it ended.
+    origin: WaylandWindowStatePtr,
+    /// Whether the compositor has reported the drag dropped.
+    dropped: bool,
+    /// Held for the length of the drag with no toplevel ever attached to it.
+    /// `None` where the compositor offers no `xdg_toplevel_drag_manager_v1`.
+    toplevel_drag: Option<xdg_toplevel_drag_v1::XdgToplevelDragV1>,
+}
+
+/// Marks a [`wl_data_source::WlDataSource`] as a platform drag's, so that its
+/// events dispatch apart from those of the sources [`DataSourceKind`] marks.
+pub struct DragSourceData;
+
+/// The only action a drag this client hands over offers, and the only one it
+/// takes from one: what the drag carries leaves where it came from.
+const DND_ACTIONS: DndAction = DndAction::Move;
+
+/// A surface showing `icon`, for the compositor to draw where the pointer
+/// carries a drag, and the buffer holding its pixels. `None` where the memory
+/// to hand the pixels over in cannot be had, nothing having been asked of the
+/// compositor by then.
+///
+/// `Argb8888` names the channels of a 32-bit little-endian word, so its bytes
+/// run blue, green, red, alpha — the order [`DragIcon`] gives them in. A
+/// big-endian host would need them the other way round.
+fn drag_icon(
+    globals: &Globals,
+    icon: &DragIcon,
+) -> Option<(wl_surface::WlSurface, wl_buffer::WlBuffer)> {
+    let size = icon.size();
+    let stride = size.width.0 * DragIcon::BYTES_PER_PIXEL as i32;
+    let file = memory_file(icon.pixels())?;
+    let pool = globals
+        .shm
+        .create_pool(file.as_fd(), icon.pixels().len() as i32, &globals.qh, ());
+    let buffer = pool.create_buffer(
+        0,
+        size.width.0,
+        size.height.0,
+        stride,
+        wl_shm::Format::Argb8888,
+        &globals.qh,
+        (),
+    );
+    pool.destroy();
+    let surface = globals.compositor.create_surface(&globals.qh, ());
+    surface.set_buffer_scale(icon.scale().get());
+    Some((surface, buffer))
+}
+
+/// A file holding `bytes` in memory, for the compositor to map them out of.
+fn memory_file(bytes: &[u8]) -> Option<File> {
+    let fd = unsafe { libc::memfd_create(c"gpui-drag-icon".as_ptr(), libc::MFD_CLOEXEC) };
+    if fd < 0 {
+        return None;
+    }
+    let mut file = unsafe { File::from_raw_fd(fd) };
+    file.write_all(bytes).log_err()?;
+    Some(file)
+}
