+/// other: the objects of a drag still running are not a spent source's to let
+/// go of.
+fn drag_carried_on<'a>(
+    state: &'a mut WaylandClientState,
+    source: &wl_data_source::WlDataSource,
+) -> Option<&'a mut OutgoingDrag> {
+    state
+        .outgoing_drag
+        .as_mut()
+        .filter(|drag| drag.source.id() == source.id())
