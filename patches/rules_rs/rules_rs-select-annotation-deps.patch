@@ -105,6 +105,12 @@ def _additive_build_file_content(mctx, annotation):
     content += annotation.additive_build_file_content
     return content
 
+def _merge_selects(resolved, annotated):
+    merged = dict(resolved)
+    for triple, items in annotated.items():
+        merged[triple] = sorted({item: None for item in merged.get(triple, []) + items}.keys())
+    return merged
+
