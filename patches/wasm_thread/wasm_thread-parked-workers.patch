+//! Workers whose thread has finished, kept to run a later thread: starting a worker loads and instantiates the module
+//! anew, and a worker's spawn of one waits on the main thread to start it.
+
+use std::{
+    arch::wasm32,
+    sync::{
+        atomic::{AtomicU32, Ordering},
+        Arc, Mutex,
+    },
+};
+
+use super::{utils::SpinLockMutex, WebWorkerContext, WorkerSetup};
+
+/// How long a parked worker waits for a thread before it ends, which lets the threads of one task's stages, and of a
+/// task begun soon after, run on the same workers.
+const PARKED_TIMEOUT_NS: i64 = 30_000_000_000;
+
+/// What `memory.atomic.wait32` returns when its timeout passes.
+const WAIT_TIMED_OUT: i32 = 2;
+
+/// The calling worker, as listed while it is parked.
+pub(super) struct Worker(Arc<Parked>);
+
+struct Parked {
+    setup: WorkerSetup,
+    /// The address of the context of the thread handed to the worker, zero until one is.
+    work: AtomicU32,
+}
+
+static IDLE: Mutex<Vec<Arc<Parked>>> = Mutex::new(Vec::new());
+
+/// Hands `context` to the worker parked last with its setup, or gives it back where none is.
+pub(super) fn hand_over(context: WebWorkerContext) -> Result<(), WebWorkerContext> {
+    let parked = {
+        let mut idle = IDLE.lock_spin().unwrap();
+        match idle.iter().rposition(|parked| parked.setup == context.setup) {
+            Some(at) => idle.remove(at),
+            None => return Err(context),
+        }
+    };
+    parked.work.store(Box::into_raw(Box::new(context)) as u32, Ordering::Release);
+    unsafe {
+        wasm32::memory_atomic_notify(parked.work.as_ptr() as *mut i32, 1);
+    }
+    Ok(())
+}
+
+impl Worker {
+    pub(super) fn new(setup: WorkerSetup) -> Self {
+        Self(Arc::new(Parked {
+            setup,
+            work: AtomicU32::new(0),
+        }))
+    }
+
+    /// Lists the worker for [hand_over], which may give it a thread from then on, to run once
+    /// [Self::wait_for_thread] takes it up.
+    pub(super) fn park(&self) {
+        IDLE.lock_spin().unwrap().push(self.0.clone());
+    }
+
+    /// Waits for the thread handed to the parked worker, or `None` once [`PARKED_TIMEOUT_NS`] passes without one.
+    pub(super) fn wait_for_thread(&self) -> Option<Box<WebWorkerContext>> {
+        let work = &self.0.work;
+        let mut timeout = PARKED_TIMEOUT_NS;
+        loop {
+            let context = work.swap(0, Ordering::Acquire);
+            if context != 0 {
+                return Some(unsafe { Box::from_raw(context as *mut WebWorkerContext) });
+            }
+            if unsafe { wasm32::memory_atomic_wait32(work.as_ptr() as *mut i32, 0, timeout) } == WAIT_TIMED_OUT {
+                let mut idle = IDLE.lock_spin().unwrap();
+                match idle.iter().position(|other| Arc::ptr_eq(other, &self.0)) {
+                    Some(at) => {
+                        idle.remove(at);
+                        return None;
+                    }
+                    // Taken by a spawn, whose thread is on its way.
+                    None => timeout = -1,
+                }
+            }
+        }
+    }
+}
