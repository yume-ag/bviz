@@ -0,0 +1,254 @@
+//! Workers whose thread has finished, kept to run a later thread: starting a worker loads and instantiates the module
+//! anew, and a worker's spawn of one waits on the main thread to start it. Listing and taking a worker never wait on
+//! another thread, as the browser's main thread hands threads over too.
+
+use std::{
+    arch::wasm32,
+    num::NonZeroUsize,
+    sync::atomic::{AtomicU32, AtomicU64, AtomicUsize, Ordering},
+};
+
+use super::{available_parallelism, WebWorkerContext, WorkerSetup};
+
+/// [parked_cap] where the browser does not report its logical processors.
+const FALLBACK_PARKED_CAP: usize = 4;
+
+/// How long a parked worker has to take up a thread handed to it before the thread is started on a new worker, the
+/// parked one taken for ended by the browser: a live parked worker wakes in well under a millisecond.
+pub(super) const HAND_OVER_GRACE_MS: i32 = 1_000;
+
+/// [Parked::work] while no thread is handed to the worker.
+const NO_WORK: u64 = 0;
+
+/// [Parked::work] once the thread handed to the worker was taken back, which ends the worker.
+const TAKEN_BACK: u64 = u64::MAX;
+
+/// The calling worker, which [hand_over] may give a thread once it is parked.
+pub(super) struct Worker {
+    shelf: &'static Shelf,
+    parked: &'static Parked,
+}
+
+/// A worker as listed on its setup's shelf, never freed, so that a node another thread has taken since it was read
+/// stays valid to read.
+struct Parked {
+    /// The address of the worker below on the shelf, zero for none.
+    next: AtomicU32,
+    /// [NO_WORK], [TAKEN_BACK], or the address of the context of the thread handed to the worker, [counted] by
+    /// [Self::hand_overs].
+    work: AtomicU64,
+    hand_overs: AtomicU32,
+}
+
+/// The workers parked with one setup, a stack of [Parked] nodes, each on it at most once: only its own worker lists
+/// it, the first time on parking and afterwards only once a hand-over has taken it off.
+struct Shelf {
+    setup: WorkerSetup,
+    /// The top node's address, [counted] by the changes to the top, so that a top taken and listed again since it was
+    /// read fails an exchange from the one read.
+    idle: AtomicU64,
+    /// The address of the shelf listed before, zero for none.
+    next: u32,
+}
+
+/// The address of the shelf listed last, zero for none; a shelf, once listed, stays.
+static SHELVES: AtomicU32 = AtomicU32::new(0);
+
+/// At least the workers listed on all shelves: a worker is counted before it is listed and uncounted once taken.
+static PARKED: AtomicUsize = AtomicUsize::new(0);
+
+/// The most workers parked at once: the browser's logical processors.
+fn parked_cap() -> usize {
+    static CAP: AtomicUsize = AtomicUsize::new(0);
+    match CAP.load(Ordering::Relaxed) {
+        0 => {
+            let cap = available_parallelism().map_or(FALLBACK_PARKED_CAP, NonZeroUsize::get);
+            CAP.store(cap, Ordering::Relaxed);
+            cap
+        }
+        cap => cap,
+    }
+}
+
+/// A thread handed to a parked worker, which [Self::take_back] can start elsewhere if the worker never takes it up.
+pub(super) struct HandedOver {
+    parked: &'static Parked,
+    work: u64,
+}
+
+/// Hands `context` to the worker parked last with its setup, or gives it back where none is.
+pub(super) fn hand_over(context: WebWorkerContext) -> Result<HandedOver, WebWorkerContext> {
+    let Some(parked) = find_shelf(&context.setup).and_then(Shelf::pop) else {
+        return Err(context);
+    };
+    let count = parked.hand_overs.fetch_add(1, Ordering::Relaxed).wrapping_add(1);
+    let work = counted(count, Box::into_raw(Box::new(context)) as u32);
+    parked.work.store(work, Ordering::Release);
+    parked.notify();
+    Ok(HandedOver { parked, work })
+}
+
+impl HandedOver {
+    /// Takes the thread back, and ends its worker, unless the worker has taken it up.
+    pub(super) fn take_back(self) -> Option<Box<WebWorkerContext>> {
+        self.parked
+            .work
+            .compare_exchange(self.work, TAKEN_BACK, Ordering::Acquire, Ordering::Relaxed)
+            .ok()?;
+        // Wakes a worker that is merely slow, to end.
+        self.parked.notify();
+        Some(unsafe { Box::from_raw(address_of(self.work) as *mut WebWorkerContext) })
+    }
+}
+
+impl Parked {
+    fn notify(&self) {
+        unsafe {
+            wasm32::memory_atomic_notify(self.work.as_ptr() as *mut i32, 1);
+        }
+    }
+}
+
+fn find_shelf(setup: &WorkerSetup) -> Option<&'static Shelf> {
+    find_shelf_from(SHELVES.load(Ordering::Acquire), setup)
+}
+
+fn find_shelf_from(mut at: u32, setup: &WorkerSetup) -> Option<&'static Shelf> {
+    while at != 0 {
+        // SAFETY: a listed shelf is never freed.
+        let shelf = unsafe { &*(at as *const Shelf) };
+        if shelf.setup == *setup {
+            return Some(shelf);
+        }
+        at = shelf.next;
+    }
+    None
+}
+
+/// The shelf for `setup`, listed by the first worker with it, so that a setup never has two.
+fn shelf_for(setup: &WorkerSetup) -> &'static Shelf {
+    let mut head = SHELVES.load(Ordering::Acquire);
+    if let Some(listed) = find_shelf_from(head, setup) {
+        return listed;
+    }
+    let shelf = Box::into_raw(Box::new(Shelf {
+        setup: setup.clone(),
+        idle: AtomicU64::new(0),
+        next: head,
+    }));
+    loop {
+        match SHELVES.compare_exchange(head, shelf as u32, Ordering::Release, Ordering::Acquire) {
+            Ok(_) => return unsafe { &*shelf },
+            Err(now) => {
+                if let Some(listed) = find_shelf_from(now, setup) {
+                    drop(unsafe { Box::from_raw(shelf) });
+                    return listed;
+                }
+                head = now;
+                // SAFETY: `shelf` is this thread's alone until the exchange lists it.
+                unsafe { (*shelf).next = head };
+            }
+        }
+    }
+}
+
+const ADDRESS_BITS: u32 = 32;
+
+/// An address, packed with a count that tells it from the same address stored before.
+fn counted(count: u32, address: u32) -> u64 {
+    (count as u64) << ADDRESS_BITS | address as u64
+}
+
+fn address_of(counted: u64) -> u32 {
+    counted as u32
+}
+
+fn count_of(counted: u64) -> u32 {
+    (counted >> ADDRESS_BITS) as u32
+}
+
+impl Shelf {
+    fn push(&self, parked: &'static Parked) {
+        let address = parked as *const Parked as u32;
+        let mut was = self.idle.load(Ordering::Relaxed);
+        loop {
+            parked.next.store(address_of(was), Ordering::Relaxed);
+            let is = counted(count_of(was).wrapping_add(1), address);
+            match self
+                .idle
+                .compare_exchange_weak(was, is, Ordering::Release, Ordering::Relaxed)
+            {
+                Ok(_) => return,
+                Err(now) => was = now,
+            }
+        }
+    }
+
+    /// Takes the top worker, which its taker then owns until the worker lists itself again.
+    fn pop(&self) -> Option<&'static Parked> {
+        let mut was = self.idle.load(Ordering::Acquire);
+        loop {
+            let address = address_of(was);
+            if address == 0 {
+                return None;
+            }
+            // SAFETY: a node is never freed.
+            let parked = unsafe { &*(address as *const Parked) };
+            // Stale where another thread has taken the node since, which fails the exchange on the count.
+            let next = parked.next.load(Ordering::Relaxed);
+            let is = counted(count_of(was).wrapping_add(1), next);
+            match self
+                .idle
+                .compare_exchange_weak(was, is, Ordering::Acquire, Ordering::Acquire)
+            {
+                Ok(_) => {
+                    PARKED.fetch_sub(1, Ordering::Relaxed);
+                    return Some(parked);
+                }
+                Err(now) => was = now,
+            }
+        }
+    }
+}
+
+impl Worker {
+    pub(super) fn new(setup: &WorkerSetup) -> Self {
+        Self {
+            shelf: shelf_for(setup),
+            parked: Box::leak(Box::new(Parked {
+                next: AtomicU32::new(0),
+                work: AtomicU64::new(NO_WORK),
+                hand_overs: AtomicU32::new(0),
+            })),
+        }
+    }
+
+    /// Lists the worker for [hand_over], which may give it a thread from then on, to run once
+    /// [Self::wait_for_thread] takes it up; `false`, listing nothing, where [parked_cap] workers are listed already.
+    #[must_use]
+    pub(super) fn park(&self) -> bool {
+        let cap = parked_cap();
+        let counted = PARKED.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |parked| {
+            (parked < cap).then_some(parked + 1)
+        });
+        if counted.is_err() {
+            return false;
+        }
+        self.shelf.push(self.parked);
+        true
+    }
+
+    /// Waits for the thread handed to the parked worker, or `None` where it was taken back, which ends the worker.
+    pub(super) fn wait_for_thread(&self) -> Option<Box<WebWorkerContext>> {
+        let work = &self.parked.work;
+        loop {
+            match work.swap(NO_WORK, Ordering::Acquire) {
+                NO_WORK => unsafe {
+                    wasm32::memory_atomic_wait64(work.as_ptr() as *mut i64, NO_WORK as i64, -1);
+                },
+                TAKEN_BACK => return None,
+                handed => return Some(unsafe { Box::from_raw(address_of(handed) as *mut WebWorkerContext) }),
+            }
+        }
+    }
+}
