@@ -0,0 +1,92 @@
+//! Workers whose thread has finished, kept to run a later thread: starting a worker loads and instantiates the module
+//! anew, and a worker's spawn of one waits on the main thread to start it.
+
+use std::{
+    arch::wasm32,
+    num::NonZeroUsize,
+    sync::{
+        atomic::{AtomicU32, AtomicUsize, Ordering},
+        Arc, Mutex,
+    },
+};
+
+use super::{available_parallelism, utils::SpinLockMutex, WebWorkerContext, WorkerSetup};
+
+/// [parked_cap] where the browser does not report its logical processors.
+const FALLBACK_PARKED_CAP: usize = 4;
+
+/// The calling worker, as listed while it is parked.
+pub(super) struct Worker(Arc<Parked>);
+
+struct Parked {
+    setup: WorkerSetup,
+    /// The address of the context of the thread handed to the worker, zero until one is.
+    work: AtomicU32,
+}
+
+static IDLE: Mutex<Vec<Arc<Parked>>> = Mutex::new(Vec::new());
+
+/// The most workers parked at once: the browser's logical processors.
+fn parked_cap() -> usize {
+    static CAP: AtomicUsize = AtomicUsize::new(0);
+    match CAP.load(Ordering::Relaxed) {
+        0 => {
+            let cap = available_parallelism().map_or(FALLBACK_PARKED_CAP, NonZeroUsize::get);
+            CAP.store(cap, Ordering::Relaxed);
+            cap
+        }
+        cap => cap,
+    }
+}
+
+/// Hands `context` to the worker parked last with its setup, or gives it back where none is.
+pub(super) fn hand_over(context: WebWorkerContext) -> Result<(), WebWorkerContext> {
+    let parked = {
+        let mut idle = IDLE.lock_spin().unwrap();
+        match idle.iter().rposition(|parked| parked.setup == context.setup) {
+            Some(at) => idle.remove(at),
+            None => return Err(context),
+        }
+    };
+    parked.work.store(Box::into_raw(Box::new(context)) as u32, Ordering::Release);
+    unsafe {
+        wasm32::memory_atomic_notify(parked.work.as_ptr() as *mut i32, 1);
+    }
+    Ok(())
+}
+
+impl Worker {
+    pub(super) fn new(setup: WorkerSetup) -> Self {
+        Self(Arc::new(Parked {
+            setup,
+            work: AtomicU32::new(0),
+        }))
+    }
+
+    /// Lists the worker for [hand_over], which may give it a thread from then on, to run once
+    /// [Self::wait_for_thread] takes it up; `false`, listing nothing, where [parked_cap] workers are listed already.
+    #[must_use]
+    pub(super) fn park(&self) -> bool {
+        let cap = parked_cap();
+        let mut idle = IDLE.lock_spin().unwrap();
+        if idle.len() >= cap {
+            return false;
+        }
+        idle.push(self.0.clone());
+        true
+    }
+
+    /// Waits for the thread handed to the parked worker.
+    pub(super) fn wait_for_thread(&self) -> Box<WebWorkerContext> {
+        let work = &self.0.work;
+        loop {
+            let context = work.swap(0, Ordering::Acquire);
+            if context != 0 {
+                return unsafe { Box::from_raw(context as *mut WebWorkerContext) };
+            }
+            unsafe {
+                wasm32::memory_atomic_wait32(work.as_ptr() as *mut i32, 0, -1);
+            }
+        }
+    }
+}
