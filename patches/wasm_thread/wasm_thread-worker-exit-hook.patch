+/// Runs `hook` on each worker's wasm thread as it ends, the last code the thread runs: a parked worker keeps its wasm
+/// thread across the threads handed to it. A later call changes nothing.
+pub fn on_worker_exit(hook: fn()) {
+    let _ = WORKER_EXIT.set(hook);
+}
+
+static WORKER_EXIT: std::sync::OnceLock<fn()> = std::sync::OnceLock::new();
+
 /// Entry point for web workers: runs the thread it is given, then each thread handed to the worker while it is parked,
 /// and returns once the worker cannot park or a thread handed to it is taken back.
 #[wasm_bindgen]
 pub fn wasm_thread_entry_point(ptr: u32) {
+    run_worker(ptr);
+    if let Some(hook) = WORKER_EXIT.get() {
+        hook();
+    }
+}
+
+fn run_worker(ptr: u32) {
     // SAFETY: `ptr` is the context [Builder::spawn_for_context] leaked for this worker alone and posted in its one
     // initialization message; [parked::HandedOver::take_back] reclaims only contexts handed to parked workers.
     let mut ctx = unsafe { Box::from_raw(ptr as *mut WebWorkerContext) };
