     }
 
@@ -23,7 +23,7 @@ pub fn available_parallelism() -> io::Result<NonZeroUsize> {
 }
 
 pub fn is_web_worker_thread() -> bool {
-    js_sys::eval("self").unwrap().dyn_into::<WorkerGlobalScope>().is_ok()
+    js_sys::global().dyn_into::<WorkerGlobalScope>().is_ok()
 }
 
