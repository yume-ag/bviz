diff --git a/src/wasm32/mod.rs b/src/wasm32/mod.rs
index 41b9b43..1a4147b 100644
--- a/src/wasm32/mod.rs
+++ b/src/wasm32/mod.rs
@@ -57,8 +57,7 @@ impl WorkerMessage {
     pub fn post(self) {
         let req = Box::new(self);
 
-        js_sys::eval("self")
-            .unwrap()
+        js_sys::global()
             .dyn_into::<DedicatedWorkerGlobalScope>()
             .unwrap()
             .post_message(&JsValue::from(Box::into_raw(req) as u32))
@@ -277,7 +276,7 @@ impl Builder {
         } = self;
 
         // Get worker script as URL encoded blob
-        let script = worker_script_url.unwrap_or(get_worker_script(wasm_bindgen_shim_url));
+        let script = worker_script_url.unwrap_or_else(|| get_worker_script(wasm_bindgen_shim_url));
 
         // Todo: figure out how to set stack size
         let options = WorkerOptions::new();
@@ -297,7 +296,6 @@ impl Builder {
 
         #[cfg(feature = "es_modules")]
         {
-            js_sys::eval(include_str!("js/module_workers_polyfill.min.js")).unwrap();
             options.set_type(WorkerType::Module);
         }
         #[cfg(not(feature = "es_modules"))]
