common --enable_platform_specific_config
common:linux --host_platform=//platforms:local_gnu

# Builds for a platform other than the host. Naming the output directory after
# the platform keeps them from overwriting the host build's artifacts, which are
# otherwise reached by the same paths.
build:cross --experimental_platform_in_output_dir

# Cross-compile to macOS. --enable_platform_specific_config above claims the
# bare `macos` config name for builds whose host is a Mac, so these are named
# for the target.
build:macos_arm64 --config=cross
build:macos_arm64 --platforms=//platforms:macos_arm64

build:macos_x86_64 --config=cross
build:macos_x86_64 --platforms=//platforms:macos_x86_64

# Builds for the browser.
build:wasm32_web --config=cross
build:wasm32_web --platforms=//platforms:wasm32_web

build:wasm32_web_threads --config=cross
build:wasm32_web_threads --platforms=//platforms:wasm32_web_threads

# Resolve protoc via the registered proto toolchain rather than the legacy hardcoded path.
common --incompatible_enable_proto_toolchain_resolution

# Build and run Java with a JDK Bazel fetches, never one found on the host.
common --java_language_version=21
common --java_runtime_version=remotejdk_21
common --tool_java_language_version=21
common --tool_java_runtime_version=remotejdk_21

# Overlap crate compilation across the dependency DAG: each crate emits .rmeta and
# its dependents start from that metadata instead of waiting for full codegen.
# Only under remote execution: built locally, a crate's metadata and its library
# resolve to versions rustc considers different, and its dependents then fail to
# find it (E0460, E0463).
build:remote --@rules_rs_rules_rust//rust/settings:pipelined_compilation

# CI's external-repository fetching and package loading wait on remote round
# trips, not the CPU, so their concurrency is set by how many requests can be in
# flight rather than by the runner's cores that the default derives it from.
common:ci --loading_phase_threads=32

build --@rules_rs_rules_rust//rust/settings:clippy.toml=//:clippy.toml

# Tools are built without the target's Starlark flags: each distinct value would
# fork a tool configuration that re-analyses the toolchains and crates. Clippy
# lints tool crates too, so they keep the project's clippy.toml.
build --incompatible_exclude_starlark_flags_from_exec_config
build --experimental_propagate_custom_flag=@rules_rs_rules_rust//rust/settings:clippy.toml

# Style and lint checks; both report a finding rather than rewriting the source.
build:rustfmt --aspects=@rules_rs_rules_rust//rust:defs.bzl%rustfmt_aspect
build:rustfmt --output_groups=rustfmt_checks
build:clippy --aspects=@rules_rs_rules_rust//rust:defs.bzl%rust_clippy_aspect
build:clippy --output_groups=clippy_checks

# Both checks alongside the default outputs, which a bare --output_groups replaces.
build:check --aspects=@rules_rs_rules_rust//rust:defs.bzl%rustfmt_aspect,@rules_rs_rules_rust//rust:defs.bzl%rust_clippy_aspect
build:check --output_groups=+rustfmt_checks,+clippy_checks

# Builds that are published, so their archives name the commit they come from.
build:release --workspace_status_command=tools/source_commit.sh

build:perf_profile -c opt
build:perf_profile --@rules_rs_rules_rust//rust/settings:extra_rustc_flag=-Cdebuginfo=2
build:perf_profile --@rules_rs_rules_rust//rust/settings:extra_rustc_flag=-Cforce-frame-pointers=yes
build:perf_profile --@rules_rs_rules_rust//rust/settings:extra_rustc_flag=-Cstrip=none

build:bazel_profile --noslim_profile
build:bazel_profile --record_full_profiler_data
build:bazel_profile --experimental_profile_include_target_label
build:bazel_profile --experimental_profile_include_target_configuration

# Remote cache configuration.
import %workspace%/.bazelrc.remote

try-import %workspace%/user.bazelrc
