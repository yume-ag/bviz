load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//tools/wasm_test:wasm_test.bzl", "wasm_test")

rust_library(
    name = "bazel_flags",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_bazel_flags",
    visibility = [
        "//bazel_flags/args:__pkg__",
        "//bazel_flags/oracle:__pkg__",
        "//graph/layout:__pkg__",
        "//ui/graph:__pkg__",
    ],
)

rust_test(
    name = "bazel_flags_test",
    size = "small",
    crate = ":bazel_flags",
)

rust_binary(
    name = "bazelrc",
    srcs = ["bin/bazelrc.rs"],
    crate_name = "bviz_bazelrc",
    deps = [
        "//bazel_flags/args",
        "@crates//:clap",
    ],
)

wasm_test(
    name = "bazel_flags_wasm_test",
    test = ":bazel_flags_test",
)
