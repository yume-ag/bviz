load("@rules_java//java:java_binary.bzl", "java_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//platforms:web.bzl", "NOT_WEB")

java_binary(
    name = "bazelrc_oracle",
    testonly = True,
    srcs = ["java/bviz/oracle/BazelrcOracle.java"],
    # Bazel's string encoding reads a private field of java.lang.String, as the
    # Bazel server is permitted to.
    jvm_flags = ["--add-opens=java.base/java.lang=ALL-UNNAMED"],
    main_class = "bviz.oracle.BazelrcOracle",
    target_compatible_with = NOT_WEB,
    deps = ["@bazel_server_jar//:server"],
)

rust_test(
    name = "bazelrc_oracle_test",
    size = "small",
    srcs = ["bazelrc_oracle_test.rs"],
    crate_name = "bviz_bazelrc_oracle_test",
    data = [":bazelrc_oracle"],
    env = {"BAZELRC_ORACLE": "$(rlocationpath :bazelrc_oracle)"},
    deps = [
        "//bazel_flags",
        "@rules_rs_rules_rust//rust/runfiles",
    ],
)
