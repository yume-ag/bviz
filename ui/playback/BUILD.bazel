load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "playback",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_ui_playback",
    visibility = [
        "//bviz:__pkg__",
        "//ui/console:__pkg__",
        "//ui/execlog:__pkg__",
        "//ui/graph:__pkg__",
        "//ui/trace:__pkg__",
        "//ui/workspace:__pkg__",
    ],
    deps = [
        "//invocation",
        "//ui/assets",
        "//ui/components",
        "//ui/theme",
        "@crates//:gpui",
    ],
)

rust_test(
    name = "playback_test",
    size = "small",
    crate = ":playback",
)
