load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "graph_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "bviz_ui_graph",
    visibility = ["//bviz:__pkg__"],
    deps = [
        "//bazel_flags",
        "//graph/layout",
        "//invocation",
        "//label",
        "//ui/assets",
        "//ui/components",
        "//ui/graph/args",
        "//ui/playback",
        "//ui/session",
        "//ui/theme",
        "//ui/workspace",
        "//util/input",
        "//util/parallel",
        "//util/switches",
        "//util/time",
        "@crates//:cfg-if",
        "@crates//:clap",
        "@crates//:fixedbitset",
        "@crates//:gpui",
        "@crates//:lyon_tessellation",
        "@crates//:nucleo",
        "@crates//:rustc-hash",
    ],
)

rust_binary(
    name = "graph",
    srcs = ["src/main.rs"],
    crate_name = "bviz_ui_graph_bin",
    deps = [":graph_lib"],
)

rust_test(
    name = "graph_test",
    size = "small",
    crate = ":graph_lib",
    deps = ["@crates//:fastrand"],
)
