load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "args",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bviz_ui_graph_args",
    visibility = [
        "//bazel_flags/args:__pkg__",
        "//bviz:__pkg__",
        "//cli:__pkg__",
        "//ui/graph:__pkg__",
    ],
    deps = [
        "@crates//:clap",
    ],
)

rust_test(
    name = "args_test",
    size = "small",
    crate = ":args",
)
