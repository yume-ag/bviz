load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# text_input.rs was written from gpui's input example.
filegroup(
    name = "text_input_src",
    srcs = ["src/text_input.rs"],
    package_metadata = [
        "//:package_metadata",
        "//LICENSES:gpui_derived_source",
    ],
)

rust_library(
    name = "components",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/text_input.rs"],
    ) + [":text_input_src"],
    crate_name = "bviz_ui_components",
    visibility = [
        "//bviz:__pkg__",
        "//ui/console:__pkg__",
        "//ui/execlog:__pkg__",
        "//ui/graph:__pkg__",
        "//ui/playback:__pkg__",
        "//ui/shell:__pkg__",
        "//ui/trace:__pkg__",
        "//ui/workspace:__pkg__",
    ],
    deps = [
        "//invocation",
        "//label",
        "//ui/assets",
        "//ui/theme",
        "@crates//:gpui",
    ],
)

rust_test(
    name = "components_test",
    size = "small",
    crate = ":components",
    deps = ["@crates//:gpui_platform"],
)
