load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "trace_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "bviz_ui_trace",
    visibility = ["//bviz:__pkg__"],
    deps = [
        "//critical_path",
        "//invocation",
        "//label",
        "//trace/layout",
        "//trace/profile",
        "//ui/assets",
        "//ui/components",
        "//ui/playback",
        "//ui/session",
        "//ui/spawn_phase",
        "//ui/theme",
        "//ui/trace/args",
        "//ui/workspace",
        "//util/input",
        "//util/switches",
        "//util/time",
        "@crates//:clap",
        "@crates//:gpui",
    ] + select({
        "@platforms//cpu:wasm32": ["//ui/web"],
        "//conditions:default": [],
    }),
)

rust_binary(
    name = "trace",
    srcs = ["src/main.rs"],
    crate_name = "bviz_ui_trace_bin",
    deps = [
        ":trace_lib",
        "//alloc",
    ],
)

rust_test(
    name = "trace_test",
    size = "small",
    crate = ":trace_lib",
)
